msgstr ""
"無料診断の<terms>利用規約</terms>と<privacy>プライバシーポリシー</privacy>を"
"お読みください。"

#: assets/js/build/admin/settings.js:1
#: src/js/jp4wc/admin/settings/components/SecurityScan.js
msgid "Run the check again"
msgstr "もう一度診断する"

#. translators: %s: date and time of the consent
#: assets/js/build/admin/settings.js:1
#: src/js/jp4wc/admin/settings/components/SecurityScan.js
#, php-format
msgid "You agreed to the Terms of Use and the Privacy Policy on %s."
