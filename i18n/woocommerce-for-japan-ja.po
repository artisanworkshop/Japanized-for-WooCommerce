msgstr "レポート作成: %s"

#: assets/js/build/admin/settings.js:6 assets/js/build/admin/settings.js:10
msgid "Total score"
msgstr "総合スコア"

#: assets/js/build/admin/settings.js:6 assets/js/build/admin/settings.js:18
msgid "Items that need action"
msgstr "対応が必要な項目"

#: assets/js/build/admin/settings.js:6 assets/js/build/admin/settings.js:11
msgid "No items need action."
msgstr "対応が必要な項目はありません。"

