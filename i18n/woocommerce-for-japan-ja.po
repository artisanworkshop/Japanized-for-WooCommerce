#: assets/js/build/admin/settings.js:1
#: src/js/jp4wc/admin/settings/components/SecurityScan.js
msgid ""
"wc.artws.info no longer accepts the earlier registration of this site, so "
"earlier results can no longer be shown. The next check registers this site "
