a\u5de5\u623f\uff09\u304b\u3089\u65e2\u77e5\u306e\u8106\u5f31\u6027\u306e\u4e00\u89a7\u3092\u53d6\u5f97\u3057\u3001\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u306e\u30d7\u30e9\u30b0\u30a4\u30f3\u30fb\u30c6\u30fc\u30de\u30fbWordPress \u3068\u7167\u5408\u3057\u307e\u3059\u3002\u9001\u4fe1\u3059\u308b\u306e\u306f User-Agent \u30d8\u30c3\u30c0\u30fc\u306b\u542b\u307e\u308c\u308b\u3001\u3053\u306e\u30d7\u30e9\u30b0\u30a4\u30f3\u30fbWordPress\u30fbWooCommerce\u30fbPHP \u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3060\u3051\u3067\u3059\u3002"],"No fixed version yet. Deactivate and delete it, or replace it with another plugin or theme.":["\u4fee\u6b63\u7248\u306f\u307e\u3060\u3042\u308a\u307e\u305b\u3093\u3002\u505c\u6b62\u3057\u3066\u524a\u9664\u3059\u308b\u304b\u3001\u5225\u306e\u30d7\u30e9\u30b0\u30a4\u30f3\u3084\u30c6\u30fc\u30de\u306b\u7f6e\u304d\u63db\u3048\u3066\u304f\u3060\u3055\u3044\u3002"],"Update it to the latest version.":["\u6700\u65b0\u7248\u306b\u66f4\u65b0\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Update %1$s to a fixed version (%2$s) or later.":["%1$s \u3092\u4fee\u6b63\u7248\uff08%2$s\uff09\u4ee5\u964d\u306b\u66f4\u65b0\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Satisfied":["\u5145\u8db3"],"Action needed":["\u8981\u5bfe\u5fdc"],"Unconfirmed":["\u672a\u78ba\u8a8d"],"Total score":["\u7dcf\u5408\u30b9\u30b3\u30a2"],"The lowest score of the four requirements.":["4\u8981\u4ef6\u306e\u3046\u3061\u6700\u3082\u4f4e\u3044\u70b9\u6570\u3067\u3059\u3002"],"Passed %1$d \/ Action needed %2$d \/ Unconfirmed %3$d":["\u554f\u984c\u306a\u3057 %1$d \/ \u8981\u5bfe\u5fdc %2$d \/ \u672a\u78ba\u8a8d %3$d"],"No items need action.":["\u5bfe\u5fdc\u304c\u5fc5\u8981\u306a\u9805\u76ee\u306f\u3042\u308a\u307e\u305b\u3093\u3002"],"Some checks could not be run (see \"All checks\" below).":["\u4e00\u90e8\u306e\u30c1\u30a7\u30c3\u30af\u306f\u5b9f\u884c\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\uff08\u4e0b\u306e\u300c\u3059\u3079\u3066\u306e\u30c1\u30a7\u30c3\u30af\u300d\u3092\u53c2\u7167\uff09\u3002"],"Severity":["\u91cd\u5927\u5ea6"],"Item":["\u9805\u76ee"],"Fixed version":["\u4fee\u6b63\u7248"],"How to fix":["\u4fee\u6b63\u65b9\u6cd5"],"Reference":["\u53c2\u7167"],"None":["\u306a\u3057"],"Details":["\u8a73\u7d30"],"All checks":["\u3059\u3079\u3066\u306e\u30c1\u30a7\u30c3\u30af"],"Passed":["\u554f\u984c\u306a\u3057"],"\"Unconfirmed\" means the check could not be run on this site, for example because the server cannot send requests to itself. It costs no points.":["\u300c\u672a\u78ba\u8a8d\u300d\u306f\u3001\u30b5\u30fc\u30d0\u30fc\u304c\u81ea\u5206\u81ea\u8eab\u306b\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u9001\u308c\u306a\u3044\u306a\u3069\u306e\u7406\u7531\u3067\u3001\u3053\u306e\u30b5\u30a4\u30c8\u3067\u306f\u30c1\u30a7\u30c3\u30af\u3092\u5b9f\u884c\u3067\u304d\u306a\u304b\u3063\u305f\u3053\u3068\u3092\u8868\u3057\u307e\u3059\u3002\u6e1b\u70b9\u306f\u3057\u307e\u305b\u3093\u3002"],"The vulnerability data could not be downloaded for several days, so the installed software is not checked for known vulnerabilities. Make sure this server can connect to %s.":["\u8106\u5f31\u6027\u30c7\u30fc\u30bf\u3092\u6570\u65e5\u9593\u53d6\u5f97\u3067\u304d\u3066\u3044\u306a\u3044\u305f\u3081\u3001\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u306e\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\u3092\u65e2\u77e5\u306e\u8106\u5f31\u6027\u3068\u7167\u5408\u3067\u304d\u3066\u3044\u307e\u305b\u3093\u3002\u3053\u306e\u30b5\u30fc\u30d0\u30fc\u304b\u3089 %s \u306b\u63a5\u7d9a\u3067\u304d\u308b\u304b\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"The vulnerability data has not been downloaded yet, so known vulnerabilities are not checked. It is downloaded once a day.":["\u8106\u5f31\u6027\u30c7\u30fc\u30bf\u306f\u307e\u3060\u53d6\u5f97\u3055\u308c\u3066\u3044\u306a\u3044\u305f\u3081\u3001\u65e2\u77e5\u306e\u8106\u5f31\u6027\u306f\u7167\u5408\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u30c7\u30fc\u30bf\u306f1\u65e51\u56de\u53d6\u5f97\u3057\u307e\u3059\u3002"],"The result of the security check could not be loaded.":["\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u30c1\u30a7\u30c3\u30af\u306e\u7d50\u679c\u3092\u8aad\u307f\u8fbc\u3081\u307e\u305b\u3093\u3067\u3057\u305f\u3002"],"The re-check could not be started.":["\u518d\u30c1\u30a7\u30c3\u30af\u3092\u958b\u59cb\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002"],"The security check is off. Turn it on below and save the settings to check this site.":["\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u30c1\u30a7\u30c3\u30af\u306f\u30aa\u30d5\u3067\u3059\u3002\u3053\u306e\u30b5\u30a4\u30c8\u3092\u30c1\u30a7\u30c3\u30af\u3059\u308b\u306b\u306f\u3001\u4e0b\u3067\u30aa\u30f3\u306b\u3057\u3066\u8a2d\u5b9a\u3092\u4fdd\u5b58\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"This check shows what needs attention. It does not guarantee compliance with the Credit Card Security Guidelines.":["\u3053\u306e\u30c1\u30a7\u30c3\u30af\u306f\u5bfe\u5fdc\u304c\u5fc5\u8981\u306a\u7b87\u6240\u3092\u793a\u3059\u3082\u306e\u3067\u3059\u3002\u30af\u30ec\u30b8\u30c3\u30c8\u30ab\u30fc\u30c9\u30fb\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u30ac\u30a4\u30c9\u30e9\u30a4\u30f3\u3078\u306e\u6e96\u62e0\u3092\u4fdd\u8a3c\u3059\u308b\u3082\u306e\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"],"This site has not been checked yet. The first check runs shortly in WP-Cron, or start it with \"Re-check now\".":["\u3053\u306e\u30b5\u30a4\u30c8\u306f\u307e\u3060\u30c1\u30a7\u30c3\u30af\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u6700\u521d\u306e\u30c1\u30a7\u30c3\u30af\u306f\u307e\u3082\u306a\u304f WP-Cron \u3067\u5b9f\u884c\u3055\u308c\u307e\u3059\u3002\u300c\u4eca\u3059\u3050\u518d\u30c1\u30a7\u30c3\u30af\u300d\u3067\u958b\u59cb\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002"],"Re-checking\u2026":["\u518d\u30c1\u30a7\u30c3\u30af\u4e2d\u2026"],"Re-check now":["\u4eca\u3059\u3050\u518d\u30c1\u30a7\u30c3\u30af"],"Last checked: %s":["\u6700\u7d42\u30c1\u30a7\u30c3\u30af: %s"],"Vulnerability data: %s":["\u8106\u5f31\u6027\u30c7\u30fc\u30bf: %s"],"The re-check runs in the background. The results appear here when it finishes.":["\u518d\u30c1\u30a7\u30c3\u30af\u306f\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u3067\u5b9f\u884c\u3055\u308c\u307e\u3059\u3002\u7d42\u308f\u308b\u3068\u3053\u3053\u306b\u7d50\u679c\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002"],"The re-check has finished.":["\u518d\u30c1\u30a7\u30c3\u30af\u304c\u7d42\u308f\u308a\u307e\u3057\u305f\u3002"],"The re-check has not finished yet. It runs with WP-Cron, so reload this page later to see the results.":["\u518d\u30c1\u30a7\u30c3\u30af\u306f\u307e\u3060\u7d42\u308f\u3063\u3066\u3044\u307e\u305b\u3093\u3002WP-Cron \u3067\u5b9f\u884c\u3055\u308c\u308b\u305f\u3081\u3001\u3057\u3070\u3089\u304f\u3057\u3066\u304b\u3089\u3053\u306e\u30da\u30fc\u30b8\u3092\u518d\u8aad\u307f\u8fbc\u307f\u3057\u3066\u7d50\u679c\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Items that need action":["\u5bfe\u5fdc\u304c\u5fc5\u8981\u306a\u9805\u76ee"],"Settings":["\u8a2d\u5b9a"],"Security check":["\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u30c1\u30a7\u30c3\u30af"],"Turning it off also stops the checks on this tab and deletes their results.":["\u30aa\u30d5\u306b\u3059\u308b\u3068\u3001\u3053\u306e\u30bf\u30d6\u306e\u30c1\u30a7\u30c3\u30af\u3082\u6b62\u307e\u308a\u3001\u7d50\u679c\u306f\u524a\u9664\u3055\u308c\u307e\u3059\u3002"],"Vulnerability management":["\u8106\u5f31\u6027\u5bfe\u7b56"],"Admin access control":["\u7ba1\u7406\u753b\u9762\u306e\u30a2\u30af\u30bb\u30b9\u5236\u9650"],"Data directory exposure":["\u30c7\u30fc\u30bf\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306e\u9732\u898b\u5bfe\u7b56"],"Malware protection":["\u30de\u30eb\u30a6\u30a7\u30a2\u5bfe\u7b56"],"Known vulnerabilities in the installed software":["\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\u306e\u65e2\u77e5\u306e\u8106\u5f31\u6027"],"Plugin updates left uninstalled for 180 days or more":["180\u65e5\u4ee5\u4e0a\u9069\u7528\u3055\u308c\u3066\u3044\u306a\u3044\u30d7\u30e9\u30b0\u30a4\u30f3\u306e\u66f4\u65b0"],"Update the plugins on the Plugins screen, and delete the plugins you no longer use.":["\u300c\u30d7\u30e9\u30b0\u30a4\u30f3\u300d\u753b\u9762\u3067\u30d7\u30e9\u30b0\u30a4\u30f3\u3092\u66f4\u65b0\u3057\u3001\u4f7f\u3063\u3066\u3044\u306a\u3044\u30d7\u30e9\u30b0\u30a4\u30f3\u306f\u524a\u9664\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"PHP, WordPress or WooCommerce version that is no longer supported":["\u30b5\u30dd\u30fc\u30c8\u304c\u7d42\u4e86\u3057\u305f PHP\u30fbWordPress\u30fbWooCommerce \u306e\u30d0\u30fc\u30b8\u30e7\u30f3"],"Update WordPress and WooCommerce, and ask your hosting provider how to switch to a supported PHP version.":["WordPress \u3068 WooCommerce \u3092\u66f4\u65b0\u3057\u3001\u30b5\u30dd\u30fc\u30c8\u4e2d\u306e PHP \u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3078\u306e\u5207\u308a\u66ff\u3048\u65b9\u6cd5\u3092\u30b5\u30fc\u30d0\u30fc\u4f1a\u793e\u306b\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Automatic updates of WordPress security releases and plugins":["WordPress \u306e\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u30ea\u30ea\u30fc\u30b9\u3068\u30d7\u30e9\u30b0\u30a4\u30f3\u306e\u81ea\u52d5\u66f4\u65b0"],"Turn on automatic updates for every plugin on the Plugins screen, and do not turn off the automatic security updates of WordPress (WP_AUTO_UPDATE_CORE or a filter).":["\u300c\u30d7\u30e9\u30b0\u30a4\u30f3\u300d\u753b\u9762\u3067\u3059\u3079\u3066\u306e\u30d7\u30e9\u30b0\u30a4\u30f3\u306e\u81ea\u52d5\u66f4\u65b0\u3092\u6709\u52b9\u306b\u3057\u3001WordPress \u306e\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u66f4\u65b0\u306e\u81ea\u52d5\u9069\u7528\u3092\u6b62\u3081\u306a\u3044\u3067\u304f\u3060\u3055\u3044\uff08WP_AUTO_UPDATE_CORE \u3084\u30d5\u30a3\u30eb\u30bf\u30fc\uff09\u3002"],"User named \"admin\"":["\u300cadmin\u300d\u3068\u3044\u3046\u540d\u524d\u306e\u30e6\u30fc\u30b6\u30fc"],"Create an administrator with another user name, then delete the admin user and attribute its content to the new one.":["\u5225\u306e\u30e6\u30fc\u30b6\u30fc\u540d\u3067\u7ba1\u7406\u8005\u3092\u4f5c\u6210\u3057\u3066\u304b\u3089 admin \u30e6\u30fc\u30b6\u30fc\u3092\u524a\u9664\u3057\u3001\u305d\u306e\u30b3\u30f3\u30c6\u30f3\u30c4\u3092\u65b0\u3057\u3044\u7ba1\u7406\u8005\u306b\u5272\u308a\u5f53\u3066\u3066\u304f\u3060\u3055\u3044\u3002"],"Login page protection":["\u30ed\u30b0\u30a4\u30f3\u30da\u30fc\u30b8\u306e\u4fdd\u8b77"],"Limit login attempts with a security plugin, or restrict wp-login.php to your IP addresses or a password in the server configuration.":["\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u30d7\u30e9\u30b0\u30a4\u30f3\u3067\u30ed\u30b0\u30a4\u30f3\u306e\u8a66\u884c\u56de\u6570\u3092\u5236\u9650\u3059\u308b\u304b\u3001\u30b5\u30fc\u30d0\u30fc\u306e\u8a2d\u5b9a\u3067 wp-login.php \u3078\u306e\u30a2\u30af\u30bb\u30b9\u3092 IP \u30a2\u30c9\u30ec\u30b9\u3084\u30d1\u30b9\u30ef\u30fc\u30c9\u3067\u5236\u9650\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Two-factor authentication":["\u4e8c\u8981\u7d20\u8a8d\u8a3c"],"Install a two-factor authentication plugin and turn it on for administrators.":["\u4e8c\u8981\u7d20\u8a8d\u8a3c\u306e\u30d7\u30e9\u30b0\u30a4\u30f3\u3092\u5c0e\u5165\u3057\u3001\u7ba1\u7406\u8005\u306b\u5bfe\u3057\u3066\u6709\u52b9\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"XML-RPC open to anyone":["\u8ab0\u3067\u3082\u5229\u7528\u3067\u304d\u308b XML-RPC"],"If nothing uses XML-RPC (the WordPress mobile apps, Jetpack and some services do), block xmlrpc.php with a security plugin or the server configuration.":["XML-RPC \u3092\u4f7f\u3046\u9023\u643a\uff08WordPress \u306e\u30e2\u30d0\u30a4\u30eb\u30a2\u30d7\u30ea\u3001Jetpack\u3001\u4e00\u90e8\u306e\u30b5\u30fc\u30d3\u30b9\uff09\u304c\u7121\u3051\u308c\u3070\u3001\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u30d7\u30e9\u30b0\u30a4\u30f3\u3084\u30b5\u30fc\u30d0\u30fc\u306e\u8a2d\u5b9a\u3067 xmlrpc.php \u3078\u306e\u30a2\u30af\u30bb\u30b9\u3092\u6b62\u3081\u3066\u304f\u3060\u3055\u3044\u3002"],"User list in the REST API":["REST API \u306e\u30e6\u30fc\u30b6\u30fc\u4e00\u89a7"],"Stop the users REST route (\/wp-json\/wp\/v2\/users) from listing users to visitors who are not logged in, for example with a security plugin.":["\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u30d7\u30e9\u30b0\u30a4\u30f3\u306a\u3069\u3067\u3001\u30ed\u30b0\u30a4\u30f3\u3057\u3066\u3044\u306a\u3044\u8a2a\u554f\u8005\u306b REST API \u306e\u30e6\u30fc\u30b6\u30fc\u4e00\u89a7\uff08\/wp-json\/wp\/v2\/users\uff09\u3092\u8fd4\u3055\u306a\u3044\u3088\u3046\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"File listing of the uploads directory":["\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306e\u30d5\u30a1\u30a4\u30eb\u4e00\u89a7\u8868\u793a"],"Turn off directory listing in the server configuration (on Apache, add Options -Indexes to .htaccess).":["\u30b5\u30fc\u30d0\u30fc\u306e\u8a2d\u5b9a\u3067\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306e\u4e00\u89a7\u8868\u793a\u3092\u7121\u52b9\u306b\u3057\u3066\u304f\u3060\u3055\u3044\uff08Apache \u306a\u3089 .htaccess \u306b Options -Indexes \u3092\u8ffd\u52a0\uff09\u3002"],"Backups, database dumps and logs in public directories":["\u516c\u958b\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306b\u3042\u308b\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u30fb\u30c7\u30fc\u30bf\u30d9\u30fc\u30b9\u306e\u30c0\u30f3\u30d7\u30fb\u30ed\u30b0"],"Move or delete the backups, archives, database dumps and log files in the WordPress, wp-content and uploads directories, or block them in the server configuration.":["WordPress\u30fbwp-content\u30fbuploads \u306e\u5404\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306b\u3042\u308b\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u30fb\u30a2\u30fc\u30ab\u30a4\u30d6\u30fb\u30c7\u30fc\u30bf\u30d9\u30fc\u30b9\u306e\u30c0\u30f3\u30d7\u30fb\u30ed\u30b0\u306e\u30d5\u30a1\u30a4\u30eb\u3092\u79fb\u52d5\u307e\u305f\u306f\u524a\u9664\u3059\u308b\u304b\u3001\u30b5\u30fc\u30d0\u30fc\u306e\u8a2d\u5b9a\u3067\u30a2\u30af\u30bb\u30b9\u3092\u6b62\u3081\u3066\u304f\u3060\u3055\u3044\u3002"],"Error messages shown on the site":["\u30b5\u30a4\u30c8\u306b\u8868\u793a\u3055\u308c\u308b\u30a8\u30e9\u30fc\u30e1\u30c3\u30bb\u30fc\u30b8"],"Set WP_DEBUG_DISPLAY (or WP_DEBUG) to false in wp-config.php.":["wp-config.php \u3067 WP_DEBUG_DISPLAY\uff08\u307e\u305f\u306f WP_DEBUG\uff09\u3092 false \u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"WooCommerce log files that can be downloaded":["\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3067\u304d\u308b WooCommerce \u306e\u30ed\u30b0\u30d5\u30a1\u30a4\u30eb"],"Block wp-content\/uploads\/wc-logs\/ in the server configuration (nginx does not read the .htaccess file WooCommerce puts there).":["\u30b5\u30fc\u30d0\u30fc\u306e\u8a2d\u5b9a\u3067 wp-content\/uploads\/wc-logs\/ \u3078\u306e\u30a2\u30af\u30bb\u30b9\u3092\u6b62\u3081\u3066\u304f\u3060\u3055\u3044\uff08WooCommerce \u304c\u305d\u3053\u306b\u7f6e\u304f .htaccess \u3092 nginx \u306f\u8aad\u307f\u307e\u305b\u3093\uff09\u3002"],"HTTPS on the checkout and My account pages":["\u6c7a\u6e08\u30da\u30fc\u30b8\u3068\u30de\u30a4\u30a2\u30ab\u30a6\u30f3\u30c8\u30da\u30fc\u30b8\u306e HTTPS"],"Install an SSL certificate and change the WordPress Address and Site Address in Settings > General to https:\/\/.":["SSL \u8a3c\u660e\u66f8\u3092\u5c0e\u5165\u3057\u3001\u300c\u8a2d\u5b9a\u300d>\u300c\u4e00\u822c\u300d\u306e WordPress \u30a2\u30c9\u30ec\u30b9\u3068\u30b5\u30a4\u30c8\u30a2\u30c9\u30ec\u30b9\u3092 https:\/\/ \u306b\u5909\u66f4\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"File editing in the admin screens":["\u7ba1\u7406\u753b\u9762\u304b\u3089\u306e\u30d5\u30a1\u30a4\u30eb\u7de8\u96c6"],"Add define( 'DISALLOW_FILE_EDIT', true ); to wp-config.php.":["wp-config.php \u306b define( 'DISALLOW_FILE_EDIT', true ); \u3092\u8ffd\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Malware scanning or a web application firewall":["\u30de\u30eb\u30a6\u30a7\u30a2\u306e\u30b9\u30ad\u30e3\u30f3\u307e\u305f\u306f WAF"],"Install a security plugin that scans for malware or filters attacks.":["\u30de\u30eb\u30a6\u30a7\u30a2\u3092\u30b9\u30ad\u30e3\u30f3\u3059\u308b\u304b\u653b\u6483\u3092\u906e\u65ad\u3059\u308b\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u30d7\u30e9\u30b0\u30a4\u30f3\u3092\u5c0e\u5165\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"PHP files in the uploads directory":["\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u5185\u306e PHP \u30d5\u30a1\u30a4\u30eb"],"Check the PHP files in the uploads directory and delete the ones you do not know, which may be malware. Also stop PHP from running there in the server configuration.":["\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306b\u3042\u308b PHP \u30d5\u30a1\u30a4\u30eb\u3092\u78ba\u8a8d\u3057\u3001\u5fc3\u5f53\u305f\u308a\u306e\u7121\u3044\u3082\u306e\u306f\u524a\u9664\u3057\u3066\u304f\u3060\u3055\u3044\uff08\u30de\u30eb\u30a6\u30a7\u30a2\u306e\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\uff09\u3002\u30b5\u30fc\u30d0\u30fc\u306e\u8a2d\u5b9a\u3067\u3001\u3053\u306e\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u3067\u306e PHP \u306e\u5b9f\u884c\u3082\u6b62\u3081\u3066\u304f\u3060\u3055\u3044\u3002"],"The vulnerability data has not been updated for a while, so vulnerabilities disclosed since then are not checked.":["\u8106\u5f31\u6027\u30c7\u30fc\u30bf\u304c\u3057\u3070\u3089\u304f\u66f4\u65b0\u3055\u308c\u3066\u3044\u306a\u3044\u305f\u3081\u3001\u305d\u308c\u4ee5\u964d\u306b\u516c\u958b\u3055\u308c\u305f\u8106\u5f31\u6027\u306f\u7167\u5408\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"],"License":["\u30e9\u30a4\u30bb\u30f3\u30b9"],"Update the affected plugins, themes or WordPress to a fixed version, or remove the ones that have no fix.":["\u8a72\u5f53\u3059\u308b\u30d7\u30e9\u30b0\u30a4\u30f3\u30fb\u30c6\u30fc\u30de\u30fbWordPress \u3092\u4fee\u6b63\u6e08\u307f\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u306b\u66f4\u65b0\u3059\u308b\u304b\u3001\u4fee\u6b63\u7248\u306e\u7121\u3044\u3082\u306e\u306f\u524a\u9664\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"vulnerability severity\u0004Critical":["\u7dca\u6025"],"vulnerability severity\u0004High":["\u9ad8"],"vulnerability severity\u0004Medium":["\u4e2d"],"vulnerability severity\u0004Low":["\u4f4e"]}}}